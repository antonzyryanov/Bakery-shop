# Installable Node.js dependencies (server, web client, mobile)
# Reinstall with: npm install in server/, client/, or mobile/
node_modules/

# npm / yarn / pnpm install artifacts & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/

# Expo / React Native local caches (regenerated locally)
mobile/.expo/
.expo/

# Optional lockfile backups / temp install dirs
*.tgz
